{
  "name": "zerobili",
  "version": "0.1.2",
  "private": true,
  "description": "把映间 MARGIN 装进桌面壳与 Android WebView 的 B 站客户端",
  "author": "zc team",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "debug": "node scripts/start.js --dev",
    "sync": "node scripts/sync-margin.js",
    "icons": "python scripts/make-icons.py",
    "snapshot": "node scripts/start.js --snapshot --no-sandbox",
    "dist": "node scripts/dist.js",
    "android": "node scripts/android.js debug",
    "android:release": "node scripts/android.js release"
  },
  "build": {
    "appId": "top.zgric.zerobili",
    "productName": "zerobili",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "shell/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "zerobili-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "zerobili",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  }
}
